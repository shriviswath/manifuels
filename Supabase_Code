-- ═══════════════════════════════════════════════════════
--  ManiFuels v2.5 — Migration: Multi-User + New Features
--
--  WHAT THIS DOES:
--    1. Adds 4 family user logins with hashed passwords
--    2. Adds customer_profiles (per-customer fixed discount rate)
--    3. Adds pack_register (40ml pack purchase log)
--    4. Adds activity_log (who did what, when)
--    5. Adds created_by / updated_by columns to existing tables
--    6. Adds indexes for speed on date-filtered queries
--
--  HOW TO RUN:
--    Paste this entire file into:
--      Supabase Dashboard → SQL Editor → New Query → Run
--
--  SAFE TO RE-RUN: Uses CREATE IF NOT EXISTS / ON CONFLICT.
--                  Will not delete or overwrite existing data.
-- ═══════════════════════════════════════════════════════


-- ─── 1. USERS TABLE ───────────────────────────────────
-- Stores the 4 family logins. Passwords are hashed with SHA256
-- (matching the hash function in index.html).
-- Last login + login count tracked for activity visibility.
CREATE TABLE IF NOT EXISTS users (
  username      TEXT PRIMARY KEY,
  display_name  TEXT NOT NULL,
  password_hash TEXT NOT NULL,
  role          TEXT NOT NULL DEFAULT 'staff',
  last_login    TIMESTAMPTZ,
  login_count   INTEGER DEFAULT 0,
  created_at    TIMESTAMPTZ DEFAULT NOW()
);

