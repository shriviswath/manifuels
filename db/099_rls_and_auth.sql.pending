-- ManiFuels — 006_rls_and_auth.sql   ⚠ NOT YET APPLIED — READ FIRST
--
-- This is the security migration. It is staged rather than applied because it
-- is a coordinated cutover: the client has to move to Supabase Auth in the same
-- release, otherwise every request starts failing.
--
-- What it fixes:
--   • Row Level Security is off. The anon key in index.html can read and write
--     every table for every user — customer balances, staff salaries, drawings.
--   • Passwords sit in plaintext in the client source.
--   • _isOwner comes from sessionStorage, so any user can grant themselves
--     owner in devtools, and .owner-only is a CSS class, not a permission.
--
-- It also introduces station_id, which fixes the deeper problem: user_id is
-- currently the username, so the four owners each see only the rows they
-- personally entered. There are four sets of books, not one station's.
--
-- Rename to 006_rls_and_auth.sql when the matching client release is ready.

-- 1 ── one station, many members ────────────────────────────────────
create table if not exists public.stations (
  id         uuid primary key default gen_random_uuid(),
  name       text not null,
  created_at timestamptz default now()
);

create table if not exists public.station_members (
  station_id uuid not null references public.stations(id) on delete cascade,
  auth_uid   uuid not null references auth.users(id) on delete cascade,
  role       text not null default 'staff',   -- owner | manager | staff
  primary key (station_id, auth_uid)
);

create or replace function public.current_station()
returns uuid language sql stable security definer set search_path = public as $$
  select station_id from public.station_members where auth_uid = auth.uid() limit 1;
$$;

create or replace function public.is_owner()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from public.station_members
    where auth_uid = auth.uid() and role in ('owner','manager')
  );
$$;

-- 2 ── add station_id to every table, backfill, then enforce ────────
do $$
declare t text; sid uuid;
begin
  insert into public.stations (name)
  select 'Mani Fuels' where not exists (select 1 from public.stations);
  select id into sid from public.stations limit 1;

  foreach t in array array[
    'shift_records','stock_items','ledger_entries','oil_invoices','fuel_loads',
    'app_settings','customer_profiles','pack_register','activity_log',
    'rate_history','staff','staff_attendance','staff_payments','owner_drawings',
    'dip_readings'
  ] loop
    if to_regclass('public.'||t) is not null then
      execute format('alter table public.%I add column if not exists station_id uuid', t);
      execute format('update public.%I set station_id = %L where station_id is null', t, sid);
      execute format('alter table public.%I alter column station_id set not null', t);
      execute format('alter table public.%I alter column station_id set default public.current_station()', t);
      execute format('create index if not exists %I on public.%I (station_id)', t||'_station_idx', t);
    end if;
  end loop;
end $$;

-- 3 ── RLS: members of the station see the station's rows, nobody else ──
do $$
declare t text;
begin
  foreach t in array array[
    'shift_records','stock_items','ledger_entries','oil_invoices','fuel_loads',
    'app_settings','customer_profiles','pack_register','activity_log',
    'rate_history','staff','staff_attendance','staff_payments','dip_readings'
  ] loop
    if to_regclass('public.'||t) is not null then
      execute format('alter table public.%I enable row level security', t);
      execute format('drop policy if exists station_rw on public.%I', t);
      execute format($f$create policy station_rw on public.%I
        for all to authenticated
        using (station_id = public.current_station())
        with check (station_id = public.current_station())$f$, t);
    end if;
  end loop;
end $$;

-- Owner-only tables: payroll and drawings are not staff-readable.
alter table public.owner_drawings enable row level security;
drop policy if exists owners_only on public.owner_drawings;
create policy owners_only on public.owner_drawings
  for all to authenticated
  using  (station_id = public.current_station() and public.is_owner())
  with check (station_id = public.current_station() and public.is_owner());

-- 4 ── retire the plaintext user table ──────────────────────────────
-- After every owner has a Supabase Auth account and station_members row:
--   drop table if exists public.users;
